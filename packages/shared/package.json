{
  "name": "@curium/shared",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types/qr": {
      "types": "./dist/types/qr.d.ts",
      "default": "./dist/types/qr.js"
    },
    "./constants/theme": {
      "types": "./dist/constants/theme.d.ts",
      "default": "./dist/constants/theme.js"
    },
    "./constants/qrPresets": {
      "types": "./dist/constants/qrPresets.d.ts",
      "default": "./dist/constants/qrPresets.js"
    },
    "./constants/colorUtils": {
      "types": "./dist/constants/colorUtils.d.ts",
      "default": "./dist/constants/colorUtils.js"
    },
    "./utils/svg-export": {
      "types": "./dist/utils/svg-export.d.ts",
      "default": "./dist/utils/svg-export.js"
    },
    "./utils/storage": {
      "types": "./dist/utils/storage.d.ts",
      "default": "./dist/utils/storage.js"
    },
    "./services/history": {
      "types": "./dist/services/history.d.ts",
      "default": "./dist/services/history.js"
    },
    "./services/settings": {
      "types": "./dist/services/settings.d.ts",
      "default": "./dist/services/settings.js"
    },
    "./services/templates": {
      "types": "./dist/services/templates.d.ts",
      "default": "./dist/services/templates.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -p tsconfig.json --build --clean"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
